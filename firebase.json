{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/blog",
        "destination": "/blog/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "pithonixai-website",
          "region": "us-central1"
        }
      }
    ]
  }
}
